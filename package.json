{
  "name": "chunkcheck",
  "version": "1.0.0",
  "description": "Analyze GitHub pull requests and return a quality score.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:action": "esbuild action/index.js --bundle --platform=node --outfile=dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^5.1.1",
    "@octokit/rest": "^22.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
